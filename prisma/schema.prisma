// מודל הנתונים של מערכת בקרת הפניות.
// ממפה את §3 באפיון הפונקציונלי (docs/specs/ticket-control-pre-plan.md).
//
// שתי הכרעות מבנה שחוזרות לאורך כל הקובץ:
//
// 1. סטטוס הוא תכונה של ה*שיוך*, לא של הפנייה. פנייה אחת יכולה להיות משויכת
//    לכמה אנשי מקצוע, וכל אחד מהם מתקדם בקצב שלו. סטטוס הפנייה מחושב מהם
//    בזמן קריאה (src/lib/ticket-status.ts) ולא נשמר — כדי שלא ייווצר מצב שבו
//    השדה השמור והשיוכים סותרים זה את זה.
// 2. מחיקות מוגבלות ב-Restrict כברירת מחדל. פנייה אמיתית לא נמחקת לעולם;
//    מחיקה שמורה לכפילות או לתקלה, ומבוצעת בידי מנהל מערכת בלבד. Cascade
//    מופיע רק היכן שהרשומה חסרת משמעות בלי ההורה שלה (שיוך, הודעה, קובץ).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────── ספירות ──────────────────────────────

/// תפקיד יחיד למשתמש פנימי (אפיון §5.ג). אין שילוב תפקידים.
enum Role {
  ADMIN // מנהל מערכת — גישה מלאה, כולל מחיקה
  OWNER // בעלים/הנהלה — קריאה רחבה, פתיחת פניות
  SITE_MANAGER // מנהל עבודה — אתר אחד בלבד
}

/// כיצד הפנייה נכנסה למערכת (אפיון §3.2 שדה 13).
enum Channel {
  SELF // המשתמש פתח בעצמו במערכת
  MANAGEMENT // הועבר מההנהלה
  WHATSAPP // הגיע מבוט וואטסאפ — רדום בגרסה זו, ראה Gate G8
  EMAIL // נפתח במייל ממשתמש מורשה — תמיד כטיוטה (אפיון §2.6, עדכון 1.3)
}

enum Room {
  SALON
  KITCHEN
  BEDROOM
  BATHROOM
  WC
  BALCONY
  MAMAD
  STAIRWELL
  PARKING
  LOBBY
  COMMON
}

/// מצב הטיפול של נמען יחיד בפנייה (אפיון §3.4).
// ‏QUESTION הוסר ב-0.4 יחד עם הכפתור שייצר אותו (אפיון §3.4, §7 שורה 31).
// שאלה אינה עוד סטטוס אלא הודעה בשרשור, ומה שמסמן אותה למנהל הוא
// ‏`deriveAwaitingReply` — דגל נגזר, לא עמודה.
enum AssignmentStatus {
  SENT // שוגר אליו, טרם נצפה
  VIEWED // פתח את הקישור
  DONE // סימן "טופל" — ממתין לאישור הפותח
  REMOVED // הוסר מהפנייה; מאבד גישה, ההיסטוריה נשמרת
}

enum AiStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  SKIPPED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum MessageKind {
  TEXT
  MEDIA
  EVENT // אירוע מערכת בשרשור (שויך/הוסר/נסגר...) — אין לו מחבר אנושי
}

// ────────────────────────────── ישויות ליבה ──────────────────────────────

model User {
  id           String  @id @default(cuid())
  role         Role
  name         String
  phone        String  @unique
  email        String? @unique
  passwordHash String

  /// חובה עבור SITE_MANAGER (מנהל עבודה משויך לאתר אחד), null עבור ADMIN/OWNER.
  /// לא נאכף ב-DB אלא בשכבת השירות, כי האילוץ תלוי בערך של role.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  /// "רשאי לפתוח פניות במייל" (אפיון §3.7 שדה 2). ברירת המחדל דלוקה, כך
  /// שההרשאה נשענת על מה שכבר מגדיר משתמש — פעיל, עם כתובת — ולא על רשימה
  /// נפרדת שמישהו צריך לזכור לתחזק.
  emailIntakeEnabled Boolean @default(true)

  /// "כתובות נוספות לפתיחת פניות במייל" (§3.7 שדה 3). לא לכניסה עם Google.
  emailAliases UserEmailAlias[]

  createdTickets  Ticket[]     @relation("TicketCreatedBy")
  handlingTickets Ticket[]     @relation("TicketHandler")
  closedTickets   Ticket[]     @relation("TicketClosedBy")
  assignments     Assignment[] // כנמען פנימי, כולל תזכורן לעצמו
  messages        Message[]
  createdTags     Tag[]
  uploadedMedia   MediaFile[] // קבצים שהמשתמש רשם
  mailMessages    MailboxMessage[] // מיילים שנקלטו ממנו

  @@index([siteId, active])
}

/// כתובת נוספת שממנה משתמש רשאי לפתוח פנייה במייל (אפיון §3.7).
///
/// **טבלה ולא מערך על `User`**, כי הכלל "כתובת אחת — משתמש אחד" צריך
/// אינדקס ייחודי על הכתובת. ייחודיות מול `User.email` — טבלה אחרת — נאכפת
/// בשירות (`assertAddressFree`), שגם מחזיר את שם המשתמש המתנגש להודעה
/// "הכתובת כבר משויכת ל[שם]". הכתובת נשמרת מנורמלת (`normalizeEmail`).
model UserEmailAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address   String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model Site {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  buildings Building[]
  users     User[]
  tickets   Ticket[]
}

/// בניין נלמד תוך כדי עבודה, **וגם** ניתן להגדרה מראש במסך 16 (הכרעת 0.3).
/// הסיכון המודע: שני שמות לאותו בניין ("א'" / "בניין א") מפצלים דוחות ותגיות.
/// שתי מיטיגציות: בממשק היצירה הבניינים מוצגים כרשימת בחירה קצרה ולא כשדה
/// טקסט חופשי, ובמסך הניהול אפשר לתקן שם או למחוק בניין שאין אליו הפניות.
model Building {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  name   String

  apartments Apartment[]
  tickets    Ticket[]

  @@unique([siteId, name])
}

model Apartment {
  id         String   @id @default(cuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  /// מספר דירה מנורמל (trim, ללא אפס מוביל) — הנרמול נעשה בשכבת השירות
  /// כדי ש-"07" ו-"7" לא ייצרו שתי דירות.
  number String

  /// הדייר קשור לדירה ולא לפנייה (אפיון §3.2 שדה 11), כי אותו דייר חוזר בפניות רבות.
  residentName String?

  tickets Ticket[]

  @@unique([buildingId, number])
}

/// תחום מקצועי (חשמל, אינסטלציה...) — רשימה נלמדת (אפיון §3.1).
model Domain {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

/// נמען חיצוני: קבלן משנה או איש מקצוע. אין לו סיסמה — הוא נכנס בקישור אישי.
model Professional {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  createdAt DateTime @default(now())

  /// איש מקצוע שעזב (הכרעת 0.4). מקביל ל-`User.active`, ומאותו נימוק:
  /// מחיקה חסומה לו ברגע שקיבל פנייה — ובלי מסלול הוצאה הוא נשאר ברשימת
  /// הנמענים לנצח. השבתה מוציאה אותו מהבוררים ומשאירה את ההיסטוריה.
  /// **אינה מבטלת קישורי גישה קיימים**: הוא עדיין נדרש לסגור מה שנפתח לפניו.
  active Boolean @default(true)

  // "חובה טלפון או מייל" נאכף בשכבת השירות: זהו אילוץ עסקי שתלוי בערוץ
  // השליחה בפועל, ועדיף שיחזיר שגיאה מוסברת בעברית ולא כשל אילוץ גולמי.

  tokens      AccessToken[]
  assignments Assignment[]
  messages    Message[]
  tagAccess   TagAccess[]
  uploadedMedia MediaFile[] // קבצים שהקבלן רשם דרך הפורטל
}

/// "קישור קסם" — טוקן נושא (bearer) לאיש מקצוע, לא לפנייה בודדת.
/// קישור הגישה של איש מקצוע. ההרשאה נבדקת דינמית בכל בקשה מול שיוכים
/// פעילים — ולכן הסרת קבלן מנתקת אותו מיידית גם אם הקישור בידיו.
model AccessToken {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  /// ‏SHA-256 של הטוקן. **זהו השדה היחיד שמסלול האימות נוגע בו**: הבקשה
  /// הנכנסת מגובבת ומושווית מולו, ואין בו שום פענוח.
  tokenHash String @unique

  /// הטוקן מוצפן (AES-256-GCM, מפתח נגזר מ-SESSION_SECRET), כדי שמנהל יוכל
  /// לשלוח שוב את **אותו** קישור. בלי זה כל שליחה חוזרת הייתה מנפיקה טוקן
  /// חדש והורגת את ההודעה הקודמת בוואטסאפ. ראה src/lib/tokens.ts.
  /// ‏null אפשרי: רשומה שנוצרה לפני שהשדה קיים, או SESSION_SECRET שהוחלף.
  tokenCipher String?

  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([professionalId, revokedAt])
}

model Ticket {
  id String @id @default(cuid())

  /// מספר פנייה קריא לאדם, לשימוש בשיחות ובהודעות יוצאות.
  seq Int @unique @default(autoincrement())

  /// null **רק** בטיוטה ממייל של מנהל מערכת או בעלים שלא זוהה בה אתר
  /// (אפיון §2.6 שלב 3, §3.2 שדה 3). נאכף ב-CHECK שנוסף במיגרציה
  /// `email_intake` — Prisma אינו מבטא CHECK, ולכן הוא נבדק גם
  /// ב-`tests/integration/schema.test.ts`.
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  // ארבעת אלה null רק בטיוטה — פנייה משוגרת חייבת את כולם (אפיון §3.2).
  buildingId  String?
  building    Building?  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  apartmentId String?
  apartment   Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  domainId    String?
  domain      Domain?    @relation(fields: [domainId], references: [id], onDelete: Restrict)
  room        Room?

  description String  @default("")
  channel     Channel

  /// טיוטה: נשמרה אך לא שוגרה ואיש לא קיבל אותה (אפיון §2.5).
  isDraft Boolean @default(false)

  /// הנמענים שנבחרו לטיוטה, כ-`{kind:"professional"|"user", id}[]`.
  /// נשמרים כאן ולא כ-Assignment בכוונה: שיוך פירושו שמישהו קיבל את הפנייה,
  /// וטיוטה במפורש לא נשלחה לאיש (אפיון §2.5). בשיגור הם הופכים לשיוכים
  /// אמיתיים והשדה מתאפס ל-null. ראה submitDraft ב-src/lib/services/tickets.ts.
  draftRecipients Json?

  createdById String
  createdBy   User   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// "מי מטפל" (אפיון §5.ד) — נקבע ידנית או אוטומטית לפי מי שכתב בשרשור.
  handlerId String?
  handler   User?   @relation("TicketHandler", fields: [handlerId], references: [id], onDelete: SetNull)

  closedAt    DateTime?
  closedById  String?
  closedBy    User?     @relation("TicketClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  reopenCount Int       @default(0)

  /// כל הודעה או שינוי סטטוס מעדכן. זהו הבסיס להסלמת 7 הימים:
  /// האפיון המקורי הסלים פניות "שלא נצפו", אבל בשיוך מרובה די בקבלן אחד
  /// שפותח את הקישור כדי שההסלמה לא תופעל לעולם — גם אם השאר מתעלמים חודש.
  lastActivityAt DateTime @default(now())

  /// סומן על ידי הג'וב היומי כדורש התערבות.
  escalated Boolean @default(false)

  createdAt DateTime @default(now())

  assignments Assignment[]
  messages    Message[]
  tags        TicketTag[]

  /// מצב כל שדה בטיוטה ממייל — תג "מהמייל", עריכה במערכת, סתירה (§5.ה4)
  draftFields DraftField[]
  /// ההתכתבות, בפנייה שנפתחה במייל בלבד (§3.2 שדה 20)
  mailThread  MailThread?

  @@index([siteId, closedAt])
  @@index([lastActivityAt])
  @@index([createdById])
  @@index([handlerId])
  // אינדקס החיפוש החופשי. ראה את ההערה ב-`MediaFile` — הוא מוצהר כאן ולא
  // ב-SQL גולמי בלבד, ובזה כל העניין.
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// שיוך פנייה↔נמען. הסטטוס יושב כאן ולא על הפנייה (אפיון §3.4).
model Assignment {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // בדיוק אחד מהשניים מאוכלס — נאכף בשכבת השירות.
  // נמען פנימי משמש גם ל"תזכורן": הפותח משייך את הפנייה לעצמו.
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Restrict)

  status          AssignmentStatus @default(SENT)
  statusChangedAt DateTime         @default(now())
  viewedAt        DateTime?
  createdAt       DateTime         @default(now())

  /// מתי יצאה בפועל הודעה אוטומטית לנמען הזה.
  /// הסטטוס "שויך" פירושו שהמערכת שייכה אותו — לא שמישהו יידע אותו. ההפרדה
  /// חשובה: מנהל שמניח שהקבלן קיבל הודעה הוא בדיוק התרחיש שבו פנייה יושבת
  /// ימים בלי שאיש יודע עליה. (עד 1.1 הסטטוס נקרא "נשלח", ואז שתי המילים
  /// היו זהות — ראו §7 שורה 44 באפיון.)
  notifiedAt DateTime?

  /// מתי ההודעה האוטומטית לנמען הזה **הפסיקה לנסות**.
  ///
  /// **אינו ההפך של `notifiedAt` אלא השלמה שלו.** `null` בשניהם פירושו
  /// "עוד לא יצא", וזה מצב זמני ולגיטימי. מה שחסר עד 1.1 הוא הצד השלישי:
  /// ג׳וב שמיצה את שלושת ניסיונותיו ננעל ל-`FAILED` ואינו רץ שוב לעולם
  /// (`src/jobs/queue.ts`), אבל השדות היחידים שהמסך הכיר נשארו `null` —
  /// ולכן הוא המשיך לומר "ההודעה בתור לשליחה" לנצח.
  ///
  /// זה קרה בפועל ב-7.9.2026: Railway חוסם SMTP יוצא, ארבעה ג׳ובים נכשלו
  /// סופית, ואיש לא ידע.
  ///
  /// **העובדה נשמרת כאן ולא נשאלת מטבלת `Job`** כדי ש-`deliveryNote` יישאר
  /// פונקציה טהורה, וכדי שמסך הפנייה לא ייצמד למבנה ה-payload של התור.
  /// מתאפס בשליחה שהצליחה — השאלה היא "מה המצב עכשיו", לא "האם אי פעם נכשל".
  notifyFailedAt DateTime?

  /// מתי המנהל פתח את הקישור לוואטסאפ עבור הנמען הזה.
  ///
  /// **אינו "נשלח", וזו כל הסיבה שהוא שדה נפרד מ-`notifiedAt`.** המערכת
  /// יודעת שהמנהל לחץ ושוואטסאפ נפתח עם ההודעה מוכנה; היא **אינה** יודעת
  /// שההודעה נשלחה בפועל, ובוודאי לא שהקבלן קרא אותה — `wa.me` פותח שיחה,
  /// והשליחה היא לחיצה נוספת באפליקציה שאין לנו גישה אליה.
  ///
  /// מה שהוא כן פותר: קבלן שיש לו טלפון ואין לו מייל אינו מקבל הודעה
  /// אוטומטית, ועד לשדה הזה **הלוח לא יכול היה להבחין בין "המנהל שלח
  /// בוואטסאפ" ל"המנהל שכח"** — שני המצבים נראו זהים לחלוטין.
  waOpenedAt DateTime?

  @@index([ticketId])
  @@index([professionalId, status])
  @@index([userId, status])
}

/// הודעה בשרשור פנייה, או בצ'אט של תגית. בדיוק אחד מ-ticketId/tagId מאוכלס.
model Message {
  id       String  @id @default(cuid())
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String?
  tag      Tag?    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  kind MessageKind
  text String?

  /// ASSIGNED / REMOVED / VIEWED / DONE / QUESTION / CLOSED / REOPENED / HANDLER_SET
  eventType String?

  /// שמות ופרטים לתצוגת האירוע, כדי שהשרשור יישאר קריא גם אם הישות שונתה מאז.
  eventMeta Json?

  // שניהם null עבור kind = EVENT.
  authorUserId         String?
  authorUser           User?         @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  authorProfessionalId String?
  authorProfessional   Professional? @relation(fields: [authorProfessionalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  media MediaFile[]

  @@index([ticketId, createdAt])
  @@index([tagId, createdAt])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
}

model MediaFile {
  id        String   @id @default(cuid())
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// המפתח באחסון האובייקטים. השם אינו נושא את שם הספק בכוונה: בפיתוח
  /// אותו מפתח מצביע על קובץ בדיסק, ובפרודקשן על אובייקט ב-R2.
  storageKey String @unique

  mimeType     String
  sizeBytes    Int
  originalName String?

  /// הקובץ נרשם לפני שהבתים עלו בפועל — ההעלאה נעשית ישירות מהדפדפן
  /// לאחסון, ורק אז הלקוח מדווח שהיא הצליחה. רשומה שנשארת false היא
  /// העלאה שנקטעה, ואין להציג אותה בשרשור.
  uploaded Boolean @default(false)

  /// מי רשם את הקובץ — משתמש פנימי או נמען חיצוני. נשמר כדי שאישור ההעלאה
  /// (confirmUpload) יוכל לוודא שהמאשר הוא המעלה, ולא כל מי שמנחש מזהה.
  /// SetNull: מחיקת המשתמש/הקבלן אינה מוחקת את הקובץ מההיסטוריה.
  uploaderUserId         String?
  uploaderUser           User?         @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)
  uploaderProfessionalId String?
  uploaderProfessional   Professional? @relation(fields: [uploaderProfessionalId], references: [id], onDelete: SetNull)

  /// תמלול אודיו בעברית
  transcription String?

  /// טקסט שחולץ מתמונה או PDF
  extractedText String?

  aiStatus  AiStatus @default(PENDING)
  aiError   String?
  createdAt DateTime @default(now())

  /// הקובץ המצורף למייל שממנו נוצר הקובץ הזה, בטיוטה ממייל
  mailboxAttachment MailboxAttachment?

  @@index([aiStatus])

  // ────────────────────────────────────────────────────────────────────
  // אינדקסי החיפוש החופשי — **מוצהרים כאן, וזה תיקון של תקלה.**
  //
  // ההערה שעמדה כאן קודם אמרה שהם "אינם ניתנים לביטוי" ב-Prisma, ולכן הם
  // חיו ב-SQL גולמי בלבד (מיגרציה `search_trigram_indexes`). זו הייתה טעות
  // עם מחיר: ב-24.7.2026 המיגרציה `add_rate_limit` — שכל תוכנה היה הוספת
  // טבלה שאין לה קשר — **הפילה את ארבעתם**, מפני ש-Prisma השווה את הסכימה
  // מול בסיס הנתונים, לא מצא אותם מוצהרים, וסיווג אותם כעודפים. מאז כל
  // חיפוש במערכת היה סריקה סדרתית של ארבע טבלאות, ואף בדיקה לא נכשלה.
  //
  // כל עוד אינדקס אינו מוצהר בסכימה הוא חשוף לאותה מחיקה בדיוק, בכל
  // מיגרציה עתידית ובכל נושא. `type: Gin` עם `ops: raw` מבטא אותם במלואם.
  //
  // (‏trgm ולא tsvector: ל-Postgres אין stemmer לעברית, ולכן חיפוש טקסט
  // מלא לא היה מזהה נטיות טוב יותר מהתאמת תת-מחרוזת. הנימוק המלא במיגרציה.)
  //
  // נאכף גם ב-`tests/integration/search-indexes.test.ts`, שמוודא מול בסיס
  // הנתונים שארבעתם קיימים — הצהרה שומרת מפני Prisma, בדיקה שומרת מפני
  // כל השאר.
  @@index([transcription(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([extractedText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// תגית — קיבוץ פניות (למשל כל ליקויי בדק בית בדירה אחת) + צ'אט קבוצתי.
/// חשוב: פתיחת תגית לאיש מקצוע חושפת לו את הצ'אט בלבד ולעולם לא את הפניות.
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  tickets  TicketTag[]
  access   TagAccess[]
  messages Message[]
}

model TicketTag {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
}

/// למי התגית פתוחה. גישה לצ'אט בלבד.
model TagAccess {
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  grantedAt      DateTime     @default(now())

  @@id([tagId, professionalId])
  @@index([professionalId])
}

/// תור עבודות בטבלה, במקום Redis. instance יחיד, עשרות עבודות ביום —
/// תשתית תור חיצונית הייתה עלות תפעול בלי תמורה.
model Job {
  id String @id @default(cuid())

  /// TRANSCRIBE / OCR / SEND_EMAIL / DAILY_ESCALATION / BACKUP
  type      String
  payload   Json
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAt     DateTime  @default(now())
  lastError String?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

/// פעימת-לב של ג'וב יומי — השורה האחרונה שהוא כותב אחרי הצלחה. ה-watchdog
/// קורא אותה כדי לזהות "רץ פעם, ואז הפסיק בשקט": מודל ה-Job חסר זמן-סיום,
/// ולכן רעננות ההרצה נשמרת כאן ולא נגזרת ממנו.
model Heartbeat {
  name String   @id
  at   DateTime
}

/// מגביל קצב על גבי טבלה, בלי Redis. חלון קבוע לכל מפתח: כל מפתח סופר
/// אירועים עד תום החלון, ואז מתאפס. המפתח הוא מזהה לוגי ("login:<מזהה>",
/// "portal:<מזהה איש מקצוע>") ולא כתובת IP — כך ההגבלה חסינה לזיוף כותרות
/// proxy ובלתי-תלויה בתצורת הפריסה. רשומות שפג תוקפן נמחקות בג'וב היומי.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────── פתיחת פנייה במייל (אפיון 1.3) ───────────────────────

enum MailDirection {
  INBOUND // נקלט מהתיבה
  OUTBOUND // נשלח מהמערכת לשולח
}

/// מצב הטיפול בשורת יומן. **PENDING אינו "נכשל"**: כשל זמני דוחה את
/// ההודעה (`nextAttemptAt`) ולעולם אינו הופך בשקט להכרעה.
enum MailState {
  PENDING
  DONE // נכנס: הוכרע (ראה `outcome`)
  SENT // יוצא: נשלח בפועל
  SIMULATED // יוצא: נכתב ללוג בלבד — אין ערוץ מייל בסביבה
  SKIPPED // יוצא: לא נשלח במכוון (הטיוטה שוגרה/נמחקה לפני השליחה, §7 שורה 77)
  FAILED // יוצא: מיצה את הניסיונות
}

/// ההכרעה על הודעה נכנסת — אוצר מילים סגור, כדי שכל הודעה בתיבה תסתיים
/// באחת מהן ואף אחת לא "תיעלם".
enum MailOutcome {
  IGNORED_BEFORE_ACTIVATION // הגיעה לפני הפעלת היכולת (§5.ה3 כלל 5)
  IGNORED_OWN_MESSAGE // נשלחה מהתיבה עצמה או על ידי המערכת
  IGNORED_AUTO_REPLY // תשובה אוטומטית (§5.ה3 כלל 7)
  IGNORED_UNAUTHORIZED // שולח שאינו משתמש מורשה (§2.6 שלב 2)
  IGNORED_SUBJECT // מייל חדש בלי "תקלה"/"תקלות" בכותרת (§2.6 שלב 1)
  GONE // ההודעה נמחקה מהתיבה לפני שנקראה
  NO_SITE // מנהל עבודה שאינו משויך לאתר — לא נוצרה טיוטה (§2.6 שלב 3)
  DRAFT_CREATED
  DRAFT_CREATED_UNPROCESSED // החילוץ אינו זמין (§2.6 שלב 3)
  REPLY_APPLIED
  REPLY_STORED_UNPROCESSED // תשובה כשהחילוץ אינו זמין
  REPLY_NOT_PERMITTED // משתמש מורשה שאינו רשאי לערוך (§5.ה3 כלל 9)
  REPLY_AFTER_DISPATCH // הטיוטה כבר שוגרה (§2.6 שלב 6)
  REPLY_AFTER_DELETION // הטיוטה נמחקה (§2.6 שלב 6)
}

/// שדות הטיוטה שמייל יכול לקבוע (§2.6 שלב 3). שם הדייר ותגיות אינם כאן.
enum DraftFieldName {
  SITE
  BUILDING
  APARTMENT
  ROOM
  DOMAIN
  DESCRIPTION
  RECIPIENTS
}

/// מצב שדה אחד בטיוטה ממייל, לצורך §5.ה4.
///
/// **הערך עצמו אינו כאן** — הוא יושב על `Ticket` (`buildingId`, `room`...)
/// ובנמעני הטיוטה, כמו בכל טיוטה. השורה מתעדת רק את מה שהמייל מוסיף לשאלה:
/// מי קבע את הערך, מתי נערך במערכת, והאם הוא בסתירה עם המייל האחרון.
model DraftField {
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field    DraftFieldName

  /// תג "מהמייל": הערך הנוכחי נקבע מתוך מייל ואיש לא ערך אותו במערכת מאז
  fromEmail Boolean @default(false)

  /// מתי נערך השדה במערכת לאחרונה (כולל הכרעה במסך 7א). השוואה מול זמן
  /// הגעת התשובה קובעת מי מאוחר יותר — "עריכה מאוחרת במערכת מכריעה".
  systemEditedAt DateTime?

  /// סתירה פתוחה: המייל האחרון נתן ערך שונה מזה שנקבע במערכת לפניו
  conflict Boolean @default(false)

  /// הערך מהמייל האחרון, כשהשדה בסתירה. מחליף ממתין קודם (§5.ה4 — "שתי
  /// אפשרויות, לא שלוש").
  emailValue Json?

  /// ההודעה שממנה הגיע `emailValue`
  emailMessageId String?
  emailMessage   MailboxMessage? @relation(fields: [emailMessageId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@id([ticketId, field])
}

/// שרשרת המיילים של טיוטה אחת.
///
/// **`ticketId` מתאפס כשהטיוטה נמחקת** (SetNull) והשרשרת נשארת: תשובה
/// שמגיעה אחר כך צריכה לדעת שהייתה כאן טיוטה ושהיא נמחקה, כדי לענות במייל
/// "הטיוטה נמחקה" (§2.6 שלב 6) ולא להתעלם כאילו מעולם לא הייתה.
model MailThread {
  id        String   @id @default(cuid())
  ticketId  String?  @unique
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  messages MailboxMessage[]
}

/// יומן התיבה **והתכתבות** — כל הודעה שנבדקה, בשני הכיוונים.
///
/// שני תפקידים בטבלה אחת, בכוונה: היומן הוא מה שמבטיח ש"אותו מייל נבדק
/// פעמיים — נקלט פעם אחת" (`gmailMessageId @unique`), וההתכתבות (§3.1) היא
/// אותן שורות עצמן כשהן שייכות לשרשרת של טיוטה. שתי טבלאות היו שני מקורות
/// אמת לשאלה "מה הגיע ומה נשלח".
///
/// **מייל שהמערכת התעלמה ממנו נשמר בלי כותרת ובלי גוף** — רק מזהים, שולח
/// והכרעה. התיבה משותפת עם מערכות אחרות, ותוכן שאינו שלנו אינו נשמר כאן.
model MailboxMessage {
  id        String        @id @default(cuid())
  direction MailDirection
  state     MailState     @default(PENDING)
  outcome   MailOutcome?

  /// מזהה Gmail. null ביוצא שטרם נשלח.
  gmailMessageId String? @unique
  gmailThreadId  String?

  /// כותרות השרשור (RFC 5322) — כך מזוהה תשובה (§5.ה3 כלל 2)
  rfcMessageId String?
  inReplyTo    String?
  referenceIds String[]

  threadId String?
  thread   MailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  /// ביוצא: ההודעה הנכנסת שעליה הוא עונה. ייחודי — **תשובה אחת להודעה**,
  /// וזו האידמפוטנטיות של המייל החוזר.
  repliesToId String?         @unique
  repliesTo   MailboxMessage? @relation("MailReply", fields: [repliesToId], references: [id], onDelete: SetNull)
  reply       MailboxMessage? @relation("MailReply")

  fromAddress  String?
  fromName     String?
  toAddress    String?
  authorUserId String?
  authorUser   User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  subject  String?
  /// בנכנס: הטקסט שנקרא (בתשובה — החדש בלבד). ביוצא: מה שנשלח.
  bodyText String?
  /// בנכנס: כל הטקסט, כולל הציטוט — לאבחון ולזיהוי ציטוט בתשובה הבאה
  fullText String?

  receivedAt DateTime?
  sentAt     DateTime?

  /// מה עלה מעיבוד ההודעה: מה עודכן, מה לא נמצא, מה נמצא בכמה התאמות
  report Json?

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  detail        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MailboxAttachment[]
  draftFields DraftField[]

  @@index([threadId, createdAt])
  @@index([state, nextAttemptAt])
  @@index([rfcMessageId])
  @@index([gmailThreadId])
}

/// קובץ מצורף (או תמונה משובצת) של הודעה נכנסת.
///
/// נשמר לכל חלק, גם כשאינו מדיה (§2.6 שלב 3: "נשמר בהתכתבות בלבד"). קובץ
/// מדיה מקבל גם `MediaFile` בטיוטה; הסרתו מהטיוטה (מסך 7) מוחקת את
/// ה-`MediaFile` ומשאירה את השורה כאן, עם `removedFromDraftAt` — כך הקובץ
/// נשאר בהתכתבות ואינו חוזר לטיוטה בתשובה הבאה (§7 שורה 69).
model MailboxAttachment {
  id        String         @id @default(cuid())
  messageId String
  message   MailboxMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  partIndex Int

  filename  String?
  mimeType  String
  sizeBytes Int
  sha256    String?

  storageKey    String?  @unique
  isMedia       Boolean
  inline        Boolean  @default(false)
  /// למה הקובץ לא נשמר או לא נכנס לטיוטה (גדול מדי, זהה לקיים, הוסר...)
  skippedReason String?

  mediaFileId        String?    @unique
  mediaFile          MediaFile? @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  removedFromDraftAt DateTime?

  createdAt DateTime @default(now())

  @@unique([messageId, partIndex])
  @@index([sha256])
}

/// מצב ערוץ הקליטה. שורה אחת לערוץ.
model MailChannelState {
  channel String @id
  /// הכתובת שהתיבה אישרה בסבב האחרון — מול `GMAIL_USER`
  mailbox String

  /// **נקבע פעם אחת**, בסבב המוצלח הראשון, ואינו זז: מיילים שהגיעו לפניו
  /// אינם נקלטים (§5.ה3 כלל 5). כיבוי והדלקה מחדש אינם מזיזים אותו, ולכן
  /// הפער שבינתיים מעובד.
  activatedAt DateTime

  lastPollAt    DateTime?
  lastPollOkAt  DateTime?
  lastPollError String?

  updatedAt DateTime @updatedAt
}
