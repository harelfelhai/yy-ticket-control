# העתק ל-.env ומלא. הקובץ הזה נשמר בגיט — .env לא, ולעולם לא יכיל ערכים אמיתיים.
# בפרודקשן הערכים נקבעים ב-Railway Variables ולא בקובץ.

# ── בסיס נתונים ──────────────────────────────────────────────────────────
# בפיתוח: `npm run db:up` מדפיס את שלוש השורות האלה מוכנות להעתקה.
# בפרודקשן: Railway מזריק DATABASE_URL אוטומטית מהשירות של Postgres.
DATABASE_URL=
# בסיס צל למיגרציות (`prisma migrate dev`). נדרש בפיתוח בלבד.
SHADOW_DATABASE_URL=
# בסיס נפרד לבדיקות אינטגרציה, כדי שריצת בדיקות לא תמחק נתוני פיתוח.
TEST_DATABASE_URL=

# ── אפליקציה ─────────────────────────────────────────────────────────────
# הבסיס שממנו נבנים קישורי הקסם שנשלחים לקבלנים. חייב להיות כתובת שהם
# יכולים לפתוח בפועל — לא localhost בפרודקשן.
APP_BASE_URL=http://localhost:3100
# מפתח הצפנת עוגיית ההתחברות. 32 תווים לפחות. ערך שונה לכל סביבה.
# ליצירה: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# סיסמת המנהל שנוצר ב-seed. להשאיר ריק בפרודקשן — אז נוצרת סיסמה אקראית
# שמודפסת פעם אחת. קובעים ערך רק בפיתוח ובבדיקות, שדורשות פרטים ידועים מראש.
SEED_ADMIN_PASSWORD=

# ── אחסון מדיה (Cloudflare R2) ───────────────────────────────────────────
# ארבעתם הולכים יחד — שלושה מתוך ארבעה אינם "כמעט מוגדר" אלא תקלה שתתגלה
# בהעלאה הראשונה, אצל מנהל שעומד בשטח עם תמונה ביד.
# **בפיתוח אפשר להשאיר ריקים**: אז הקבצים נשמרים בתיקייה `.localmedia/`
# ומוגשים דרך האפליקציה, וכל מסלול המדיה ניתן להרצה בלי חשבון בענן.
# בפרודקשן היעדרם מפיל את ההעלאה עם הודעה מפורשת.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yy-media-dev
# ויתור מפורש: `local` מורה לשמור קבצים על הדיסק גם בבנייה של פרודקשן.
# נדרש רק להתקנה על שרת יחיד שזו הכוונה בה, או לבדיקות מול בנייה. השאר
# ריק בפריסה אמיתית — אחרת קובץ שנשמר על דיסק זמני נעלם בפריסה הבאה.
MEDIA_STORAGE=

# ── שירותי AI ────────────────────────────────────────────────────────────
# שני אלה אופציונליים גם בפרודקשן, ובכוונה: הקלטה בלי תמלול היא עדיין
# הקלטה שאפשר להאזין לה, ותמונה בלי טקסט מחולץ היא תמונה שאפשר להסתכל בה.
# בלעדיהם הקובץ מסומן SKIPPED ואינו מייצר ג'וב אדום חוזר.
# תמלול אודיו בעברית (gpt-4o-mini-transcribe, נפילה ל-whisper-1)
OPENAI_API_KEY=
# חילוץ טקסט מתמונות ומ-PDF (claude-opus-4-8 עם vision)
ANTHROPIC_API_KEY=

# ── שליחת מייל ───────────────────────────────────────────────────────────
# שני אלה הולכים יחד. **בפיתוח אפשר להשאיר ריקים**: אז המערכת כותבת את
# ההודעה ללוג במקום לשלוח אותה, וכל צינור השליחה ניתן להרצה בלי חשבון
# חיצוני ובלי לשלוח דואר לאיש. בפרודקשן היעדרם מפיל את ג'וב השליחה עם
# הודעה מפורשת — מערכת שנראית עובדת ובשקט אינה מודיעה לאיש היא בדיוק
# הכישלון שהמערכת נועדה למנוע.
RESEND_API_KEY=
# כתובת השולח. חייבת להיות בדומיין מאומת ב-Resend, אחרת השליחה נדחית.
NOTIFY_FROM_EMAIL=
# בסיס נפרד ל-E2E: בדיקות האינטגרציה מרוקנות את שלהן, ובדיקות E2E נשענות על seed.
E2E_DATABASE_URL=

# ── גיבוי לילי ───────────────────────────────────────────────────────────
# נתיב ל-pg_dump ול-pg_restore. בפרודקשן הם על ה-PATH (מותקנים בקונטיינר),
# ולכן אפשר להשאיר ריק. **בפיתוח ב-Windows** embedded-postgres אינו כולל
# אותם — התקן דרך scoop (`scoop install postgresql`) והצבע לכאן, למשל:
# C:/Users/<user>/scoop/apps/postgresql/current/bin/pg_dump.exe
PG_DUMP_PATH=
PG_RESTORE_PATH=
# ה-bucket השני ב-R2 כיעד הגיבוי (fallback של Gate G6 — חשבון Google One).
# ריק בפיתוח → הגיבוי נכתב לתיקייה `.backups/`. בפרודקשן חובה, אחרת ג'וב
# הגיבוי נכשל בקול במקום לכתוב בשקט לדיסק שנמחק עם הקונטיינר.
R2_BACKUP_BUCKET=
