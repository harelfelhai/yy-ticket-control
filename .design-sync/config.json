{
  "projectId": "76e12f0a-bb47-45e2-bc2d-f12bb0b73b54",
  "shape": "package",
  "pkg": "yy-ticket-control",
  "globalName": "YyTicketControl",
  "entry": "./.design-sync/ds-entry.ts",
  "tsconfig": ".design-sync/tsconfig.ds.json",
  "srcDir": "src/components",
  "buildCmd": "node .ds-sync/node_modules/@tailwindcss/cli/dist/index.mjs -i .design-sync/ds-styles.css -o .design-sync/.cache/ds-compiled.css",
  "cssEntry": ".design-sync/.cache/ds-compiled.css",
  "extraFonts": [".design-sync/fonts/heebo.css"],
  "guidelinesGlob": ["docs/DESIGN.md"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "900x620" },
    "CameraCapture": { "cardMode": "single", "viewport": "900x620" },
    "TicketTable": { "cardMode": "column" },
    "FilterBar": { "viewport": "420x420" }
  },
  "componentSrcMap": {
    "Button": "src/components/ui/button.tsx",
    "ButtonLink": "src/components/ui/button.tsx",
    "Chip": "src/components/ui/chip.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "EmptyState": "src/components/ui/empty-state.tsx",
    "Field": "src/components/ui/field.tsx",
    "Input": "src/components/ui/field.tsx",
    "Select": "src/components/ui/field.tsx",
    "Textarea": "src/components/ui/field.tsx",
    "FilterBar": "src/components/ui/filter-bar.tsx",
    "FilterSelect": "src/components/ui/filter-bar.tsx",
    "FilterDate": "src/components/ui/filter-bar.tsx",
    "Banner": "src/components/ui/message.tsx",
    "FormError": "src/components/ui/message.tsx",
    "FormNotice": "src/components/ui/message.tsx",
    "AudioRecorder": "src/components/audio-recorder.tsx",
    "CameraCapture": "src/components/camera-capture.tsx",
    "LearnedSelect": "src/components/learned-select.tsx",
    "MediaAttachments": "src/components/media-attachments.tsx",
    "ProfessionalCreateForm": "src/components/professional-create-form.tsx",
    "RecipientPicker": "src/components/recipient-picker.tsx",
    "ReplyField": "src/components/reply-field.tsx",
    "AssignmentStatusChip": "src/components/status-chip.tsx",
    "TicketStatusChip": "src/components/status-chip.tsx",
    "TagChatMessages": "src/components/tag-chat-messages.tsx",
    "ThreadBubble": "src/components/thread-bubble.tsx",
    "ThreadDaySeparator": "src/components/thread-bubble.tsx",
    "TicketCard": "src/components/ticket-card.tsx",
    "TicketTable": "src/components/ticket-table.tsx"
  }
}
